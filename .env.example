# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Global kill switch. When false the pipeline runs fully but never posts to X.
PUBLISHING_ENABLED=false
# Dry-run: generate content and images but log the final post instead of publishing.
DRY_RUN=true
# Commentary tone: neutral | playful | spicy
BANTER_TONE=playful

# ── SportsAPI Pro (Football V2) ──────────────────────────────────────────────
# Set false to boot consumers without calling SportsAPI (seed / 429 recovery).
SPORTSAPI_ENABLED=true
SPORTSAPI_KEY=your-sportsapi-pro-key
SPORTSAPI_BASE_URL=https://api.sportsapipro.com/v2/football
SPORTSAPI_WS_URL=wss://api.sportsapipro.com/v2/football/ws

# ── Supabase (server-side only — never ship the secret key to a client) ──────
SUPABASE_URL=https://your-project-ref.supabase.co
# New-style secret key (sb_secret_...) from Settings > API Keys.
# A legacy service_role JWT also works until legacy keys are removed.
# SUPABASE_SERVICE_ROLE_KEY is still accepted as a fallback.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
# Direct Postgres connection (used for pgmq queue operations)
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
# Optional private bucket for artwork retention. Leave empty to stream directly to X.
SUPABASE_STORAGE_BUCKET=generated-match-media

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2

# ── X (Twitter) API v2 — OAuth 1.0a user context ─────────────────────────────
# Same names as twitter-api-v2: consumer key/secret + user access token/secret.
TWITTER_CONSUMER_KEY=your-twitter-consumer-key
TWITTER_CONSUMER_SECRET=your-twitter-consumer-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_SECRET=your-twitter-access-secret

# ── Circuit breaker ──────────────────────────────────────────────────────────
MAX_POSTS_PER_15_MIN=12
MAX_POSTS_PER_DAY=100

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
