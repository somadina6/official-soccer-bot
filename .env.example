# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Global kill switch. When false the pipeline runs fully but never posts to X.
PUBLISHING_ENABLED=false
# Dry-run: generate content and images but log the final post instead of publishing.
DRY_RUN=true
# Commentary tone: neutral | playful | spicy
BANTER_TONE=playful

# ── SportsAPI Pro (Football V2) ──────────────────────────────────────────────
SPORTSAPI_KEY=your-sportsapi-pro-key
SPORTSAPI_BASE_URL=https://api.sportsapipro.com/v2/football
SPORTSAPI_WS_URL=wss://api.sportsapipro.com/v2/football/ws

# ── Supabase (server-side only — never ship the service role key to a client) ─
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection (used for pgmq queue operations)
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
# Optional private bucket for artwork retention. Leave empty to stream directly to X.
SUPABASE_STORAGE_BUCKET=generated-match-media

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2

# ── X (Twitter) API v2 — OAuth 2.0 Authorization Code + PKCE ─────────────────
X_CLIENT_ID=your-x-oauth2-client-id
X_CLIENT_SECRET=your-x-oauth2-client-secret
# Obtained once via the PKCE authorization flow; refreshed automatically.
X_REFRESH_TOKEN=your-x-refresh-token
X_API_BASE_URL=https://api.x.com

# ── Circuit breaker ──────────────────────────────────────────────────────────
MAX_POSTS_PER_15_MIN=12
MAX_POSTS_PER_DAY=100

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
